{
  "name": "codequest",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "CodeQuest — 大模型算法工程师面试闯关学习站",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx scripts/validate-content.ts",
    "verify:py": "node --import tsx scripts/verify-python.ts",
    "shot": "node scripts/shot.mjs",
    "fetch:pyodide": "node scripts/fetch-pyodide.mjs",
    "test:platform": "node scripts/e2e/platform-e2e.mjs",
    "test:level": "node --import tsx scripts/e2e/level-e2e.ts",
    "db:generate": "drizzle-kit generate",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test:cloud": "node --import tsx scripts/test-cloud.ts",
    "test:cloud:e2e": "node scripts/e2e/cloud-e2e.mjs",
    "test:auth:live": "node --import tsx scripts/smoke-live-auth.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.15",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.0",
    "pyodide": "^314.0.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "@cloudflare/vite-plugin": "1.63.2",
    "@cloudflare/workers-types": "5.20261013.1",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.150.0"
  }
}
